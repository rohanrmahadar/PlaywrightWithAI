<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="VWO Login Suite" verbose="1">
    <listeners>
        <listener class-name="com.vwo.listeners.AllureListener"/>
    </listeners>
    <test name="VWO Valid Login Tests">
        <classes>
            <class name="com.vwo.tests.ValidLoginTest"/>
        </classes>
    </test>
    <test name="VWO Invalid Login Tests">
        <classes>
            <class name="com.vwo.tests.InvalidLoginTest"/>
        </classes>
    </test>
</suite>
