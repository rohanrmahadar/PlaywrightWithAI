{
  "name": "test-plan-generator",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-template": "node -e \"require('fs').copyFileSync('../02_Plan/TestPlan_Template.md','src/backend/TestPlan_Template.md')\"",
    "setup": "npm --prefix src/backend install && npm --prefix src/frontend install && npm --prefix src/frontend run build",
    "start": "npm --prefix src/backend start",
    "dev:backend": "npm --prefix src/backend run dev",
    "dev:frontend": "npm --prefix src/frontend run dev",
    "test": "npm --prefix src/backend test"
  }
}
