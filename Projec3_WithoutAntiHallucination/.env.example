# Copy to .env and fill in. .env is git-ignored.
BASE_URL=https://app.vwo.com
ALIAS_URL=https://app.wingify.com
FREE_TRIAL_URL=https://wingify.com/free-trial/

# Real account for positive / authenticated tests. Leave blank to skip those tests.
VWO_USERNAME=
VWO_PASSWORD=

# Email used for negative login tests. Keep it different from VWO_USERNAME
# so repeated failed attempts never lock out a real account.
NEGATIVE_TEST_EMAIL=testuser@example.com

PAGE_LOAD_THRESHOLD_MS=2000
DASHBOARD_LOAD_THRESHOLD_MS=5000
